# Anchor — local dev config
#
# No cloud backend, no API keys needed. Nothing secret goes in this file.
# Copy to `.env` (gitignored) if you want to override any defaults below.
# Never put real journal content or credentials in this file.

# Ollama endpoint the dev build talks to. Must stay loopback
# (127.0.0.1 / localhost) — the Rust client rejects anything else at
# runtime regardless of what's set here. Default if unset:
# http://127.0.0.1:11434
VITE_OLLAMA_HOST=http://127.0.0.1:11434

# Force-enable the fictional demo vault toggle in dev, even before a
# personal vault has entries. "true" or "false".
VITE_SHOW_DEMO_TOGGLE=true

# Frontend log verbosity, dev only: silent | error | warn | info | debug
# Debug logging never includes entry text (see SECURITY.md) but keep
# this conservative anyway.
VITE_LOG_LEVEL=warn
