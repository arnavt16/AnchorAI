# Anchor — local development configuration
#
# Anchor has NO cloud backend and needs NO API keys. There is nothing
# secret to put in this file for the app to function — that is a
# deliberate privacy property, not something missing. This file only
# holds machine-local *developer* overrides for `npm run dev`.
#
# Copy this file to `.env` (already gitignored) if you want to change
# any of these defaults. Never put journal content, real personal
# data, or credentials of any kind in this file.

# Override the Ollama endpoint the dev build talks to. Must stay
# loopback (127.0.0.1 / localhost) — Anchor's Rust client rejects any
# other host at runtime regardless of what is set here. Default if
# unset: http://127.0.0.1:11434
VITE_OLLAMA_HOST=http://127.0.0.1:11434

# Force-enable the fictional demo vault switch in the UI during dev,
# even before a personal vault has any entries. "true" or "false".
VITE_SHOW_DEMO_TOGGLE=true

# Frontend log verbosity for dev only: "silent" | "error" | "warn" | "info" | "debug"
# Never set to "debug" when working with real journal content — debug
# logging intentionally still never includes entry text (see SECURITY.md),
# but keep this conservative regardless.
VITE_LOG_LEVEL=warn
